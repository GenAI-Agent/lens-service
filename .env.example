# ==============================================================================
# APPLICATION URLs (REQUIRED for server-side operations)
# ==============================================================================
# These URLs are required for server-side API calls and operations.
# Browser environments will automatically use window.location.origin
# Server environments MUST provide these variables explicitly

# Base URL for TzAI_web application
# Used for: API calls to TzAI_web from server-side code
# Example: https://your-domain.com
NEXT_PUBLIC_BASE_URL=

# ==============================================================================
# DATABASE (REQUIRED)
# ==============================================================================
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/lens_service?schema=public"

# Database connection details (used as fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lens_service
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# ==============================================================================
# AZURE OPENAI (OPTIONAL - can be configured per workspace)
# ==============================================================================
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-api-key"
AZURE_OPENAI_DEPLOYMENT="gpt-4"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT="text-embedding-ada-002"

# ==============================================================================
# WORKSPACE (OPTIONAL - for testing)
# ==============================================================================
LENS_SERVICE_WORKSPACE_ID=""

# ==============================================================================
# TELEGRAM (OPTIONAL - for notifications)
# ==============================================================================
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
NODE_ENV=development  # production | development | test

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Copy this file to .env.local for local development
# 2. Never commit .env.local to version control
# 3. For production, set these variables in your deployment platform
# 4. Browser environments (widget usage):
#    - Will use window.location.origin automatically
# 5. Server environments (Node.js/API):
#    - These are required for server-side API calls
#    - Application will throw an error if these are missing
# 6. Database configuration is always required
# 7. Azure OpenAI is optional but recommended for AI features
# 8. DO NOT use localhost fallbacks in production
