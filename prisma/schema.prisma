// Lens Service v3 - Prisma Schema
// Database: PostgreSQL
// Run: yarn prisma generate && yarn prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LENS_SERVICE_DATABASE_URL")
}

// ==============================================================================
// Sessions (User conversations)
// ==============================================================================

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  isActive  Boolean  @default(true) @map("is_active")

  // Relations
  messages          Message[]

  @@index([userId, isActive])
  @@map("sessions")
}

// ==============================================================================
// Messages (Conversation with Memory Compact)
// ==============================================================================

model Message {
  id        Int      @id @default(autoincrement())
  sessionId String   @map("session_id") @db.Uuid
  role      String   // 'user' | 'assistant' | 'system' | 'tool'
  content   String   @db.Text
  timestamp DateTime @default(now())

  // Memory Compact fields
  isCompacted     Boolean  @default(false) @map("is_compacted")
  compactedFromId Int?     @map("compacted_from_id")
  compactedToId   Int?     @map("compacted_to_id")
  archived        Boolean  @default(false)

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  session                Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  compactedFrom          Message?  @relation("CompactedFrom", fields: [compactedFromId], references: [id], onDelete: SetNull)
  compactedTo            Message?  @relation("CompactedTo", fields: [compactedToId], references: [id], onDelete: SetNull)
  messagesCompactedFrom  Message[] @relation("CompactedFrom")
  messagesCompactedTo    Message[] @relation("CompactedTo")

  @@index([sessionId, archived, timestamp])
  @@index([sessionId, isCompacted])
  @@map("messages")
}

// ==============================================================================
// Site Prompts (Site-wide configuration)
// ==============================================================================

model SitePrompt {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  prompt    String   @db.Text
  isGlobal  Boolean  @default(true) @map("is_global")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("site_prompts")
}

// ==============================================================================
// Knowledge Base (QA with Hybrid Search: Vector + BM25)
// ==============================================================================

model KnowledgeBase {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255) // Knowledge entry name
  description String   @db.Text // Short description (used for vector embedding)
  content     String   @db.Text // Full content (BM25 searches this field, returned in search results)
  category    String? // Optional category for filtering (not used in search currently)
  keywords    String[] // Optional tags for filtering and tertiary BM25 signal
  embedding   String?  @db.Text // JSON array of floats (vector of description)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([category])
  @@index([name])
  @@map("knowledge_base")
}

// ==============================================================================
// Skills (Custom prompts for specific queries)
// ==============================================================================

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(255) // skill name used in /skill_name
  prompt    String   @db.Text // prompt to prepend to user query
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("skills")
}

// ==============================================================================
// LLM Traces (For debugging and monitoring LLM calls)
// ==============================================================================

model LLMTrace {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id") // Which session this belongs to
  userId        String   @map("user_id") // Which user made the request

  // Input & Output (exact format sent to and received from LLM)
  input         Json     @db.JsonB // Messages array sent to LLM API
  output        String   @db.Text // Complete text output from LLM

  // Status
  status        String   @default("success") // success | error | timeout
  error         String?  @db.Text // Error message if status is error

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("llm_traces")
}

// ==============================================================================
// Contact Form Fields (Available form fields definitions)
// ==============================================================================

model ContactFormField {
  id          Int      @id @default(autoincrement())
  fieldKey    String   @unique @map("field_key") @db.VarChar(100) // e.g., "name", "email", "subject"
  fieldType   String   @map("field_type") @db.VarChar(50) // "text", "email", "textarea", "select", "file"
  label       Json     @db.JsonB // Multilingual labels: {"zh-TW": "姓名", "en-US": "Name"}
  placeholder Json?    @db.JsonB // Multilingual placeholders
  isRequired  Boolean  @default(false) @map("is_required")
  options     Json?    @db.JsonB // For select fields: array of options
  validation  Json?    @db.JsonB // Validation rules (e.g., regex, maxLength)
  order       Int      @default(0) // Display order
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([fieldKey])
  @@index([order])
  @@map("contact_form_fields")
}

// ==============================================================================
// Contact Form Settings (Form configuration per tenant)
// ==============================================================================

model ContactFormSettings {
  id                    Int      @id @default(autoincrement())
  tenantId              String   @default("default") @map("tenant_id") @db.VarChar(255) // For multi-tenant support
  enabledFields         String[] @map("enabled_fields") // Array of field keys that are enabled
  problemTypes          Json     @db.JsonB // Array of problem type definitions with multilingual labels
  notificationChannels  Json     @default("[]") @map("notification_channels") @db.JsonB // Array of notification configs: [{type: 'telegram', token: '', chatId: ''}, {type: 'email', address: ''}]
  messageLanguage       String   @default("zh-TW") @map("message_language") @db.VarChar(10) // Language for notification messages
  allowFileUpload       Boolean  @default(true) @map("allow_file_upload")
  maxFileSize           Int      @default(10485760) @map("max_file_size") // Max file size in bytes (default 10MB)
  allowedFileTypes      String[] @map("allowed_file_types") // Array of allowed MIME types
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([isActive])
  @@map("contact_form_settings")
}

// ==============================================================================
// Contact Form Submissions (Store submitted form data with files)
// ==============================================================================

model ContactFormSubmission {
  id            Int      @id @default(autoincrement())
  userId        String   @map("user_id") // User who submitted the form
  sessionId     String?  @map("session_id") // Associated session if any
  formData      Json     @db.JsonB // All form field data
  attachments   Json?    @db.JsonB // Array of file information (filename, size, url/path)
  telegramSent  Boolean  @default(false) @map("telegram_sent") // Whether sent to Telegram
  telegramError String?  @map("telegram_error") @db.Text // Error if Telegram send failed
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("contact_form_submissions")
}

// ==============================================================================
// AI Generated Pages (Dynamically generated product/content pages)
// ==============================================================================

model AIPage {
  id         String   @id @default(uuid())
  pageId     String   @unique @map("page_id") // URL-safe page identifier
  title      String   @db.VarChar(500)
  template   String   @db.VarChar(100) // Template style name
  items      Json     @db.JsonB // Array of products/content items to display
  bannerUrl  String?  @map("banner_url") @db.Text // Generated banner image URL
  userId     String?  @map("user_id") // User who requested generation (optional)
  sessionId  String?  @map("session_id") // Associated session (optional)
  expiresAt  DateTime @map("expires_at") // Auto-delete after expiration
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([pageId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("ai_pages")
}

// ==============================================================================
// Products (Book catalog with hybrid search: Vector + BM25)
// ==============================================================================

model Product {
  id          Int      @id @default(autoincrement())
  productId   String   @unique @map("product_id") @db.VarChar(255) // org_prod_id from JSONL
  productName String   @map("product_name") @db.VarChar(500) // title
  description String   @db.Text // title (used for vector embedding and BM25)
  content     String   @db.Text // author + publisher + category_name + sale_price
  data        Json     @db.JsonB // {list_price, sale_price, category_name, book_type: []}
  embedding   String?  @db.Text // JSON array of floats (vector of description)
  createdAt   DateTime @map("created_at") // publish_date from JSONL
  updatedAt   DateTime @updatedAt @map("updated_at") // current timestamp

  @@index([productId])
  @@index([productName])
  @@map("products")
}
