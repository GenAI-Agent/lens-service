model user_data {
  cust_id             String                @id @db.VarChar(100)
  nick_name           String?               @db.VarChar(200)
  birth_date          String?               @db.VarChar(8)
  maxim               String?               @db.VarChar(500)
  sex                 String?               @db.Char(1)
  child_flg           String?               @db.Char(1)
  cust_nm             String?               @db.VarChar(200)
  mail_main           String?               @db.VarChar(200)
  com_city_id         String?               @db.VarChar(3)
  com_town_id         String?               @db.VarChar(3)
  lineid              String?               @db.VarChar(255)
  password_hash       String?               @db.VarChar(255)
  salt                String?               @db.VarChar(32)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  last_login          DateTime?             @db.Timestamp(6)
  emailVerified       DateTime?
  second_hand_request second_hand_request[]
  user_event          user_event[]
}

model user_event {
  id             Int        @id @default(autoincrement())
  cust_id        String?    @db.VarChar(50)
  org_prod_id    String     @db.VarChar(50)
  prod_id        String     @db.VarChar(50)
  cat4xsx_cat_id String     @db.VarChar(50)
  cat4xsx_cat_nm String     @db.VarChar(50)
  crt_time       DateTime?  @default(now()) @db.Timestamp(6)
  event_type     String     @db.VarChar(50)
  user_data      user_data? @relation(fields: [cust_id], references: [cust_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_summary {
  cust_id      String    @id @db.VarChar(100)
  crt_time     DateTime? @db.Timestamp(6)
  buyer_amt    Decimal?  @db.Decimal(10, 2)
  sale_amt     Decimal?  @db.Decimal(10, 2)
  min_acc      Int?
  collect_qty  Int?
  total_weight Int?
}

model voice_bank {
  voice_id         String    @id @db.VarChar(50)
  voice_name       String    @db.VarChar(100)
  voice_path       String    @db.VarChar(255)
  voice_transcript String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  @@index([voice_name], map: "idx_voice_name")
}

model watchlist {
  id          Int       @id @default(autoincrement())
  cust_id     String?   @db.VarChar(100)
  prod_id     String?   @db.VarChar(20)
  org_prod_id String?   @db.VarChar(20)
  crt_time    DateTime? @db.Timestamp(6)
  list_type   String?   @db.Char(1)
}

/// AI 生成頁面
/// 儲存 AI 生成的書籍推薦頁面資料
model AgenticPage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  page_id          String   @unique @db.VarChar(255)
  title            String   @db.VarChar(500)
  template         String   @db.VarChar(100)
  books            Json
  banner_image_url String?  @db.Text
  created_at       DateTime @default(now()) @db.Timestamp(6)
  updated_at       DateTime @default(now()) @db.Timestamp(6)

  @@index([page_id], map: "idx_agentic_pages_page_id")
  @@index([created_at(sort: Desc)], map: "idx_agentic_pages_created_at")
  @@map("agentic_pages")
}

