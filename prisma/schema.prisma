  org_flg              String?   @db.Char(1)
  sale_disc            Decimal?  @db.Decimal(5, 2)
  org_logcode          String?   @db.VarChar(18)
  sup_nm_main          String?   @db.VarChar(256)
  eancode              String?   @db.VarChar(18)
  sup_mode             String?   @db.Char(1)
  out_of_print         String?   @db.Char(1)
  copyright            String?   @db.Char(1)
  stk_sell             String?   @db.Char(1)
  forsale              String?   @db.Char(1)
  sale_area            String?   @db.Char(1)
  main_pub_id          String?   @db.VarChar(16)
  main_publish_date    String?   @db.Char(8)
  main_issue_date      String?   @db.Char(8)
  main_prod_serialno   String?   @db.VarChar(18)
